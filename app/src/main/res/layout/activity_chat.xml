<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wx_bg_chat"
    android:orientation="vertical">

    <!-- ============ 顶部栏 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_bar_height"
        android:background="@color/wx_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="12dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="9dp"
            android:src="@drawable/ic_back"
            app:tint="@color/wx_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="AI 助手"
                android:textColor="@color/wx_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:includeFontPadding="false"
                android:textColor="@color/wx_text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="更多"
            android:padding="9dp"
            android:src="@drawable/ic_more"
            app:tint="@color/wx_text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/wx_divider" />

    <!-- ============ 聊天区（通知条浮在上层） ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/wx_bg_chat"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 转账 / 收款通知条：仿微信顶部提示 -->
        <LinearLayout
            android:id="@+id/notify_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bg_notify_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingTop="12dp"
            android:paddingRight="14dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="提示"
                android:src="@drawable/ic_notify_transfer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/notify_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="已接收"
                    android:textColor="@color/wx_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/notify_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/wx_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/wx_divider_light" />

    <!-- ============ 输入栏 ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@color/wx_bg_gray"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <ImageView
            android:id="@+id/iv_voice"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="语音"
            android:padding="3dp"
            android:src="@drawable/ic_voice"
            app:tint="@color/wx_text_primary" />

        <EditText
            android:id="@+id/et_input"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_edit_round"
            android:hint="@string/msg_hint"
            android:imeOptions="actionSend"
            android:includeFontPadding="false"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@color/wx_text_primary"
            android:textColorHint="@color/wx_text_hint"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btn_send"
            android:layout_width="52dp"
            android:layout_height="34dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/bg_btn_green"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/send"
            android:textColor="@color/wx_text_white"
            android:textSize="14sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_emoji"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="表情"
            android:padding="3dp"
            android:src="@drawable/ic_emoji_smile"
            app:tint="@color/wx_text_primary" />

        <ImageView
            android:id="@+id/iv_plus"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="更多功能"
            android:padding="3dp"
            android:src="@drawable/ic_plus_circle"
            app:tint="@color/wx_text_primary" />
    </LinearLayout>

    <!-- ============ 表情 / 更多面板 ============ -->
    <FrameLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="@color/wx_bg_gray"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/emoji_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/plus_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
